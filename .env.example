BOT_ENVIRONMENT=dev
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8000

BOT_ALPACA_KEY=your_alpaca_paper_key
BOT_ALPACA_SECRET=your_alpaca_paper_secret
BOT_ALPACA_BASE_URL=https://paper-api.alpaca.markets
BOT_ALPACA_DATA_URL=https://data.alpaca.markets
BOT_ALPACA_FEED=iex
BOT_FINNHUB_API_KEY=
BOT_ENABLE_ANALYST_SIGNALS=true
BOT_ENABLE_NEWS_SIGNALS=true
BOT_NEWS_LOOKBACK_HOURS=24
BOT_NEWS_MAX_ARTICLES=10
BOT_MIN_TECHNICAL_BARS=61
BOT_TECHNICAL_FALLBACK_LOOKBACK_DAYS=7

BOT_SYMBOL_WATCHLIST=NVDA,TSLA,MSFT,GOOGL,AMZN,META,AMD,AVGO,PLTR,AAPL,LLY,NVO,JPM,V,MA,COST,WMT,XOM,CAT,UNH,LIN,PANW,ORCL,DE,KO
BOT_MARKET_INTERVAL_SECONDS=60
BOT_TELEGRAM_SUMMARY_INTERVAL_SECONDS=1800
BOT_MAX_POSITION_PCT=0.12
BOT_MAX_DAILY_DRAWDOWN_PCT=0.03
BOT_MAX_OPEN_POSITIONS=12
BOT_MIN_CONFIDENCE=0.8
BOT_COOLDOWN_MINUTES_AFTER_LOSS=10
BOT_ENABLE_AUTO_EXECUTION=true

# Market-hours protection: orders are blocked while the market is closed
# unless this is explicitly enabled.
BOT_ALLOW_AFTER_HOURS_TRADING=false
# Full evaluation cadence while the market is closed (seconds).
BOT_CLOSED_MARKET_INTERVAL_SECONDS=600
BOT_CLOCK_CACHE_SECONDS=60

# Protective exits are wide disaster/windfall backstops around the strategy's
# own ATR/time exits (see STRATEGY.md). Do not tighten them below the
# strategy's normal exit range or they will strangle the validated edge.
BOT_ENABLE_PROTECTIVE_EXITS=true
BOT_STOP_LOSS_PCT=0.10
BOT_TAKE_PROFIT_PCT=0.15

# Daily pullback strategy (backtest-validated defaults - see STRATEGY.md).
BOT_RISK_PER_TRADE_PCT=0.015
BOT_STRATEGY_ENTRY_RSI_MAX=20
BOT_STRATEGY_TREND_SMA_DAYS=200
BOT_STRATEGY_MAX_HOLD_DAYS=10
BOT_STRATEGY_STOP_ATR_MULTIPLE=2.5
BOT_DAILY_BARS_LOOKBACK_DAYS=340
BOT_DAILY_BARS_CACHE_MINUTES=60
BOT_FILLS_CACHE_MINUTES=10

# Intel caching (minutes) keeps cycles fast and respects API rate limits.
BOT_ANALYST_CACHE_MINUTES=60
BOT_NEWS_CACHE_MINUTES=10

# Candles older than this (minutes) degrade data_quality toward HOLD.
BOT_CANDLE_STALE_MINUTES=15
BOT_HTTP_RETRY_ATTEMPTS=3
BOT_BOTPRESS_VERIFY_TOKEN=optional_shared_secret

BOT_TELEGRAM_BOT_TOKEN=telegram_bot_token
BOT_TELEGRAM_CHAT_ID=telegram_chat_id
